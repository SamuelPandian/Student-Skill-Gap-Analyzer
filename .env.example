# NEXUS Environment Configuration Example

# Database
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/nexus_db

# Security
JWT_SECRET=nexus_super_secret_jwt_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / LLM Providers (Provider abstraction will use the available key)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# App Settings
ENV=development
PORT=8000
HOST=0.0.0.0
